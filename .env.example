# Supabase Project Settings > API. Publishable values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required only for server-side account deletion and maintenance jobs.
SUPABASE_SERVICE_ROLE_KEY=replace_in_vercel_only
# Vercel Cron authenticates the stale anonymous-account cleanup endpoint with this secret.
CRON_SECRET=replace_with_a_long_random_secret

# Cloudflare Turnstile site key. Configure the matching secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me

# Public Supabase Storage URL ending in the versioned release folder.
NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/focus-audio/v1.0.0/
# Local-only source folder used by `npm run assets:upload`.
# FOCUS_AUDIO_SOURCE_DIR=../archive/assets/focus-audio-v1.0.0

# Optional operational metadata.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
LOG_LEVEL=info

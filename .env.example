# Supabase Project Settings > API. Publishable values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required only for server-side account deletion and maintenance jobs.
SUPABASE_SERVICE_ROLE_KEY=replace_in_vercel_only
# Vercel Cron authenticates the stale anonymous-account cleanup endpoint with this secret.
CRON_SECRET=replace_with_a_long_random_secret

# Cloudflare Turnstile site key. Configure the matching secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me

# Public canonical origin used in auth and Paddle return URLs.
NEXT_PUBLIC_APP_URL=https://example.com

# Keep true only during the controlled legacy anonymous-account migration window.
ALLOW_ANONYMOUS_MIGRATION=false

# Server-signed 72-hour paid entitlement snapshot. Generate at least 32 random bytes.
ENTITLEMENT_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Paddle Billing. Use sandbox until KYC, webhook and refund drills pass.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PRICE_PLUS_MONTHLY=pri_replace_me
PADDLE_PRICE_PLUS_ANNUAL=pri_replace_me
PADDLE_PRICE_FOUNDER_LIFETIME=pri_replace_me
FOUNDER_LIFETIME_ENABLED=false
FOUNDER_LIFETIME_ENDS_AT=2026-12-31T23:59:59Z
PAYWALL_MODE=shadow

# One-time operational scripts only. Never commit real values or expose them as NEXT_PUBLIC_*.
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=replace_only_in_the_process_environment
LIFETIME_INVITE_CAMPAIGN=v1.1-founder-500
LIFETIME_INVITE_MAX_CLAIMS=500
# Optional: omit to generate a cryptographically random token when running npm run invite:create.
# LIFETIME_INVITE_TOKEN=replace_with_a_high_entropy_token

# Public Supabase Storage URL ending in the versioned release folder.
NEXT_PUBLIC_AUDIO_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/focus-audio/v1.0.0/
# Local-only source folder used by `npm run assets:upload`.
# FOCUS_AUDIO_SOURCE_DIR=../archive/assets/focus-audio-v1.0.0

# Optional operational metadata.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
LOG_LEVEL=info
